<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Vs2005DebugMcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      Caminho da instalação do VS2005 alvo (a mesma máquina/VDI onde o
      devenv.exe roda), usado para localizar EnvDTE.dll/EnvDTE80.dll em
      PublicAssemblies. Nunca aponte isto para um pacote NuGet de versão
      mais nova do EnvDTE — ver README.md, secao "Referencias COM", pelo
      motivo (risco de InvalidCastException por mismatch de interface).

      Defina via `dotnet build -p:Vs2005InstallDir="C:\Program Files\Microsoft Visual Studio 8"`
      ou edite o valor default abaixo depois de confirmar o caminho real
      na maquina alvo.
    -->
    <Vs2005InstallDir Condition="'$(Vs2005InstallDir)' == ''">C:\Program Files\Microsoft Visual Studio 8</Vs2005InstallDir>
    <Vs2005PublicAssemblies>$(Vs2005InstallDir)\Common7\IDE\PublicAssemblies</Vs2005PublicAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Referencias por caminho (nao NuGet) para as interop assemblies do
      proprio VS2005 instalado na maquina alvo. Em uma maquina sem VS2005
      (como o ambiente de dev onde este scaffold foi gerado), o build
      falha aqui de proposito — ver HANDOFF.md.
    -->
    <Reference Include="EnvDTE">
      <HintPath>$(Vs2005PublicAssemblies)\EnvDTE.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="EnvDTE80">
      <HintPath>$(Vs2005PublicAssemblies)\EnvDTE80.dll</HintPath>
      <Private>false</Private>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
  </ItemGroup>

</Project>
